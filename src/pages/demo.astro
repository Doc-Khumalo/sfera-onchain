---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Dashboard from '../components/demo/Dashboard.jsx';
import '../styles/theme.css';
import '../styles/dashboard.css';
/* the home page's stylesheet, so this page's console IS that console rather than a
   second set of rules holding the same numbers. Its animation bindings need
   `.alt` classes this page does not have, so they simply never match. */
import '../styles/alt.css';
import '../styles/demo.css';

const title = 'Permission ledger — Sfera Onchain';
const description =
  'Connect a wallet and read its standing token permissions directly from the chain. Read-only until you ask for a change, and any change is handed to your wallet unsigned.';
---

<Base title={title} description={description}>
  {/* The header, exactly as `/` opens: these are two doors onto one thing,
      and a reader who arrives here from a link should not have to work out
      whether they are still on the same site.

      No standing band under it. "Read-only until you ask for a change" was
      pinned across the top of every screen, and it is already said where it
      bears on something — in the sentence under the heading, and in the note
      under the table that says what follows from it. A claim repeated in a
      fixture stops being read. */}
  {/* The sections it links to live on the home page now, which is `/`. */}
  <SiteHeader base="/" />

  <main>
    {/* Hydrated on load rather than on sight, because here the ledger is the
        page — there is nothing above it to read first. On `/`, where it is
        a section a reader arrives at, the same component waits until they
        reach it. */}
    <Dashboard client:load />
  </main>

</Base>
