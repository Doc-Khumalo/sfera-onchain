/* The console swaps one wallet's rows for another's every twelve seconds, in
   place, mid-page. If the sets differ in length the table changes height and
   everything below it jumps — so the invariant is enforced here rather than
   left to whoever edits WALLETS next. A build that breaks it does not ship.

   The rows are also the same SHAPE by construction: exactly one carries a
   second line under its reachable figure (the NFT floor value), so no set is
   a line taller than another. */
const ROW_COUNT = WALLETS[0].rows.length;
WALLETS.forEach((w, i) => {
  if (w.rows.length !== ROW_COUNT) {
    throw new Error(
      `alt.astro: wallet ${i + 1} (${w.id}) has ${w.rows.length} rows, ` +
      `but wallet 1 has ${ROW_COUNT}. Every wallet must carry the same number ` +
      `of rows or the console changes height when it cycles and the page jumps.`
    );
  }
  const twoLine = w.rows.filter((r) => r.usd).length;
  if (twoLine !== 1) {
    throw new Error(
      `alt.astro: wallet ${i + 1} (${w.id}) has ${twoLine} rows with a second ` +
      `line under the reachable figure; every wallet must have exactly one, ` +
      `or its table is a line taller or shorter than the others.`
    );
  }
});

---

<Base title="Sfera Onchain — Control what happens before you sign.">
  <div class="alt">
    <SiteHeader />

    <section class="a-hero">
      <h1>Control what you sign.</h1>
      <p class="a-lede">
        Most of this category warns. We read what an application is really
        asking for, cut it to what you were doing, and keep the authority
        visible for as long as it exists.
      </p>

      {/* One input, and it lives on the page that uses it.
       *
       * This was the probe form itself, which meant a reader met a text field
       * here, submitted it, and — if they had arrived without an address —
       * met a second text field on /demo. Two inputs for one job reads as an
       * unfinished hand-off. The field stays where the work happens; this is
       * the invitation to go there.
       *
       * It keeps the probe's promise underneath it, because "read-only, no
       * wallet needed" is what makes the click feel safe, and moving that to
       * the next page would mean asking for the click before answering the
       * question it raises. */}
      <div class="a-cta">
        <a class="a-btn a-btn-mint a-btn-lg" href="/demo">
          See what a wallet can still lose
          <svg viewBox="0 0 16 16" aria-hidden="true" class="a-cta-arrow">
            <path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor"
              stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <p class="a-cta-note">
          Read-only, and no wallet needed. Nothing is signed, stored, or sent
          anywhere.
        </p>
        <ChainStack label="+ more, all read the same way" />
      </div>
    </section>

    <section class="a-stage" id="product" aria-label="Example wallet, corrected">
      <div class="a-console">
        <span class="a-scan" aria-hidden="true"></span>

        {/* Two tiers: who the wallet is, then what is true of it. One row
            tried to carry both and crushed three figures and their captions
            into a third of the width. */}
        <div class="a-console-head">
          <span class="a-wallet">
            <span class="a-avatar" aria-hidden="true"></span>
            <b class="a-wids">
              {WALLETS.map((w, i) => <span class={`a-wid-${i + 1}`}>{w.id}</span>)}
            </b>
            <span class="a-chip a-chip-quiet">Example wallet</span>
          </span>
          {/* The rows span chains, so a single chain chip would have been
              wrong as well as smaller. */}
          <ChainStack compact />
        </div>

        <div class="a-figs">
          <span><em>Reachable now</em>
            <b class="roll usd a-count au-exp"><span class="rnum"><i class="m" /><i class="g" /><i class="p" /></span></b>
            <i>what others can take today</i>
          </span>
          <span><em>Open</em>
            <b class="roll a-count au-open"><span class="rnum"><i class="m" /><i class="g" /><i class="p" /></span></b>
            <i>live permissions</i>
          </span>
          {/* Named for what it is. A dollar figure beside a bare word like
              "reduced" reads as money owed, when it is the opposite. */}
          <span><em>Put beyond reach, 30d</em>
            <b class="ok roll usd a-count au-red"><span class="rnum"><i class="m" /><i class="g" /><i class="p" /></span></b>
            <i>removed, not spent</i>
          </span>
        </div>

        <ConsoleTable wallets={WALLETS} />
      </div>

      {/* Verify is the half nobody else ships. The claim is not that we sent a
          transaction, it is that we asked the chain again afterwards. */}
      <p class="a-verified">
        <span class="a-tick" aria-hidden="true">✓</span>
        Read back at block 21,904,118 — allowance 100.00 USDC, collection
        approval absent. <span class="quiet">Example figures.</span>
      </p>
    </section>

    {/* Shared with `/` outright, so the two entry points differ only above
        this line and the comparison stays about the hero. */}
    <main class="a-below">
      <Stats />
      <Developers />

      <Faq contact={CONTACT} />
      {/* The deck itself, in place of the Ask — whose invitation is panel
          nine of it, in the same words. */}
      <HowItWorksDeck />
    </main>
    {/* No footer. Everything it carried now sits closer to where it is wanted:
        the founders and the invitation are the deck's closing panel, and its
        "See it step by step" link pointed at a page that is now embedded on
        this one. A footer whose every line is answered above it is furniture. */}
  </div>
</Base>
