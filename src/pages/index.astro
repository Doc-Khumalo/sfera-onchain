---
/**
 * The home page (design K, 24 Oct 2026).
 *
 * It says what the product does today, in the order a visitor needs it: the
 * promise and the two ways in, with the product as it looks now; the numbers;
 * how it works, told in six lines; the three places it works, each with what
 * it cannot do; the integration for wallets and apps; and the questions,
 * which are kept exactly as they were.
 *
 * The console that used to sit under the hero showed a table the dashboard
 * no longer has, so it went, and the step-by-step deck gave way to the story
 * the app tells.
 */
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { APP, CONTACT, SNAP } from '../data/site.js';
import Hero from '../components/k/Hero.astro';
import Story from '../components/k/Story.astro';
import Surfaces from '../components/k/Surfaces.astro';
import Stats from '../components/sections/Stats.jsx';
import Faq from '../components/sections/Faq.jsx';
import Developers from '../components/sections/Developers.jsx';
/* theme.css only for its Tailwind utilities, which the shared sections use. */
import '../styles/theme.css';
import '../styles/home.css';
import '../styles/alt.css';
import '../styles/k.css';
---

<Base title="Sfera Onchain · Cap what apps can take.">
  <div class="alt">
    <SiteHeader />
    <Hero />
    <main class="a-below">
      <Stats />
      <Story />
      <Surfaces />
      <Developers />
      <Faq contact={CONTACT} />
    </main>
    <footer class="k-foot">
      <div class="k-foot__inner">
        <span>© 2026 Sfera Onchain</span>
        <span class="k-foot__links">
          <a href={APP}>Dashboard</a>
          <a href={SNAP}>Add to MetaMask</a>
          <a href={CONTACT} target="_blank" rel="noopener">Contact</a>
        </span>
      </div>
    </footer>
  </div>
</Base>
