        state: 'Unbounded', stateTo: 'Bounded', stateTone: 'st-bad', stateToneTo: 'st-ok',
        verb: 'Limit', done: 'Limited' },
      { app: 'OpenSea', via: 'Seaport', asset: 'Collection', chain: 'ethereum', chainName: 'Ethereum',
        fault: 2, status: 'bad', grant: 'All items', grantTo: 'None', tone: 'bad', toneTo: 'gone',
