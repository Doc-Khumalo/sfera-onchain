        status: 'ok', third: true, ends: '12 Sep', state: 'Bounded', stateTone: 'st-ok', act: 'None needed',
        grant: '2,500.00', tone: 'ok' },
      { app: 'SyncSwap', via: 'Router', asset: 'Unreadable', chain: 'linea', chainName: 'Linea',
        status: 'unk', grant: '—', tone: 'quiet', still: '—', ends: '—',
        state: 'Unknown', stateTone: 'st-unk', act: 'Cannot correct' },
      { app: '1inch', via: 'Router', asset: 'USDT', chain: 'polygon', chainName: 'Polygon',
        status: 'old', grant: '1,200.00', tone: 'quiet', still: '0.00', ends: 'expired 1 Sep',
        state: 'Expired', stateTone: 'st-old', act: '—' },
      { app: 'PancakeSwap', via: 'Router', asset: 'USDT', chain: 'bnb', chainName: 'BNB Chain',
        status: 'gone', grant: 'None', tone: 'gone', still: '0.00', ends: 'revoked 4 Sep',
