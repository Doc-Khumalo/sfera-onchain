---
/**
 * Reveals sections as they enter the viewport.
 *
 * Opt-in: the class is added here, so if this script never runs the page
 * is simply visible with no animation. It can never leave content hidden.
 * Adds `shown` once per element and unobserves — a reveal, not a replaying
 * scroll effect.
 */
---

<script>
const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const targets = document.querySelectorAll('.reveal');

if (!reduced && 'IntersectionObserver' in window && targets.length) {
  document.body.classList.add('reveal-on');

  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('shown');
        io.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
  );

  targets.forEach((el) => io.observe(el));

  // Anything already on screen at load should not wait for a scroll.
  requestAnimationFrame(() => {
    targets.forEach((el) => {
      if (el.getBoundingClientRect().top < window.innerHeight) {
        el.classList.add('shown');
        io.unobserve(el);
      }
    });
  });
}
</script>
